# Normal local and hosted operation uses live services. Demo is explicit opt-in only.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SMTP_USER=
SMTP_PASS=
# Use a Google Workspace Shared Drive folder. Service accounts cannot own files
# in a personal Gmail My Drive. Add the account as a content manager.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Optional legacy fallback. Prefer the folder link in Admin → Competition settings.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Personal Gmail: Google OAuth Web Application client (server-only).
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# A 32-byte random key encoded as Base64; encrypts the stored refresh token.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
